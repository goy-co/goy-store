#!/usr/bin/env bash
# Git pre-commit hook to verify formatting

echo "🔍 Running pre-commit checks..."

# 1. Format Go
if command -v go >/dev/null 2>&1; then
    echo "  -> Formatting Go code..."
    (cd go && go fmt ./... >/dev/null)
fi

# 2. Format Rust
if command -v cargo >/dev/null 2>&1; then
    echo "  -> Checking Rust code format..."
    (cd rust && cargo fmt -- --check >/dev/null 2>&1)
    if [ $? -ne 0 ]; then
        echo "❌ Rust formatting errors found. Run 'cargo fmt' in rust/ directory."
        exit 1
    fi
fi

echo "✅ Pre-commit checks passed."
exit 0
